@model Blogic_task.Models.Smlouva

<h1>Vytvořit novou smlouvu</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="EvidencniCislo" class="control-label">Evidenční číslo</label>
                <input asp-for="EvidencniCislo" class="form-control" placeholder="Např. SML-2026-001" />
                <span asp-validation-for="EvidencniCislo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Instituce" class="control-label">Instituce</label>
                <select asp-for="Instituce" class="form-control" asp-items="Html.GetEnumSelectList<Blogic_task.Models.Instituce>()">
                    <option value="">-- Vyberte instituci --</option>
                </select>
                <span asp-validation-for="Instituce" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="KlientId" class="control-label">Zákazník (Příjmení)</label>
                <select asp-for="KlientId" class="form-control" asp-items="ViewBag.KlientId">
                    <option value="">-- Vyberte zákazníka --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SpravceId" class="control-label">Správce smlouvy (Příjmení)</label>
                <select asp-for="SpravceId" class="form-control" asp-items="ViewBag.SpravceId">
                    <option value="">-- Vyberte správce --</option>
                </select>
            </div>

            <div class="row">
                <div class="form-group col-md-4 mb-3">
                    <label asp-for="DatumUzavreni" class="control-label">Datum uzavření</label>
                    <input asp-for="DatumUzavreni" class="form-control" type="date" />
                </div>
                <div class="form-group col-md-4 mb-3">
                    <label asp-for="DatumPlatnosti" class="control-label">Platnost od</label>
                    <input asp-for="DatumPlatnosti" class="form-control" type="date" />
                </div>
                <div class="form-group col-md-4 mb-3">
                    <label asp-for="DatumUkonceni" class="control-label">Ukončeno</label>
                    <input asp-for="DatumUkonceni" class="form-control" type="date" />
                </div>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Další poradci</label>
                <select name="vybraniDalsiPoradci" class="form-control" asp-items="ViewBag.DalsiPoradciId" multiple="multiple" style="height: 100px;">
                </select>
                <small class="form-text text-muted">Pro výběr více poradců podržte klávesu Ctrl.</small>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Uložit smlouvu" class="btn btn-success" />
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na Dashboard</a>
            </div>
        </form>
    </div>
</div>