@model Blogic_task.Models.Smlouva

<h1>Detail smlouvy č. @Model.EvidencniCislo</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Instituce</dt>
        <dd class="col-sm-10">@Model.Instituce</dd>

        <dt class="col-sm-2">Datum uzavření</dt>
        <dd class="col-sm-10">@Model.DatumUzavreni.ToShortDateString()</dd>

        <dt class="col-sm-2">Datum platnosti</dt>
        <dd class="col-sm-10">@Model.DatumPlatnosti.ToShortDateString()</dd>

        <dt class="col-sm-2">Datum ukončení</dt>
        <dd class="col-sm-10">
            @(Model.DatumUkonceni?.ToShortDateString() ?? "Stále probíhá")
        </dd>

        <dt class="col-sm-2">Zákazník</dt>
        <dd class="col-sm-10">
            <a asp-controller="Klienti" asp-action="Details" asp-route-id="@Model.KlientId">
                @Model.Klient.Jmeno @Model.Klient.Prijmeni
            </a>
        </dd>

        <dt class="col-sm-2">Hlavní správce</dt>
        <dd class="col-sm-10">
            <a asp-controller="Poradci" asp-action="Details" asp-route-id="@Model.SpravceId">
                @Model.Spravce.Jmeno @Model.Spravce.Prijmeni
            </a>
        </dd>
    </dl>
</div>

<h4>Další poradci podílející se na smlouvě</h4>
<ul>
    @foreach (var poradce in Model.DalsiPoradci)
    {
        <li>
            <a asp-controller="Poradci" asp-action="Details" asp-route-id="@poradce.Id">
                @poradce.Jmeno @poradce.Prijmeni
            </a>
        </li>
    }
</ul>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na Dashboard</a>