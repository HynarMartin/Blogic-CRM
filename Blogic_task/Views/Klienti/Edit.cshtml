@model Blogic_task.Models.Klient

<h1>Upravit zákazníka</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Jmeno" class="control-label">Jméno</label>
                <input asp-for="Jmeno" class="form-control" />
                <span asp-validation-for="Jmeno" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Prijmeni" class="control-label">Příjmení</label>
                <input asp-for="Prijmeni" class="form-control" />
                <span asp-validation-for="Prijmeni" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">E-mail</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Telefon" class="control-label">Telefon</label>
                <input asp-for="Telefon" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="RodneCislo" class="control-label">Rodné číslo</label>
                <input asp-for="RodneCislo" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="DatumNarozeni" class="control-label">Datum narození</label>
                <input asp-for="DatumNarozeni" class="form-control" type="date" />
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Uložit změny" class="btn btn-warning" />
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na Dashboard</a>
            </div>
        </form>
    </div>
</div>