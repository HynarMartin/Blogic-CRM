@model Blogic_task.Models.Poradce

<h1>Detail poradce: @Model.Jmeno @Model.Prijmeni</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Telefon</dt>
        <dd class="col-sm-10">@Model.Telefon</dd>
    </dl>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <h4>Spravované smlouvy (Jako hlavní správce)</h4>
        <ul class="list-group">
            @foreach (var smlouva in Model.SpravovaneSmlouvy)
            {
                <li class="list-group-item">
                    <a asp-controller="Smlouvy" asp-action="Details" asp-route-id="@smlouva.EvidencniCislo">
                        Smlouva č. @smlouva.EvidencniCislo
                    </a>
                </li>
            }
        </ul>
    </div>

    <div class="col-md-6">
        <h4>Další smlouvy (Jako spolupracující poradce)</h4>
        <ul class="list-group">
            @foreach (var smlouva in Model.DalsiSmlouvy)
            {
                <li class="list-group-item">
                    <a asp-controller="Smlouvy" asp-action="Details" asp-route-id="@smlouva.EvidencniCislo">
                        Smlouva č. @smlouva.EvidencniCislo
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na Dashboard</a>
</div>