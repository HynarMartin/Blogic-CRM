@model Blogic_task.Models.Poradce

<h1>Smazat poradce</h1>

<h3 class="text-danger">Opravdu chcete smazat tohoto poradce?</h3>
<div>
    <h4>@Model.Jmeno @Model.Prijmeni</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Telefon</dt>
        <dd class="col-sm-10">@Model.Telefon</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Smazat navždy" class="btn btn-danger" />
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na Dashboard</a>
    </form>
</div>